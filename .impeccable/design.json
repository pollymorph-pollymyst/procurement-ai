  ],
  "narrative": {
    "northStar": "The Tear-Off Calendar",
    "overview": "The page is printed like a Soviet wall calendar: the leaf is today, the task is printed on it, and everything else is dates ahead. Cool newsprint ground, black ink, and one calendar red reserved for \"today\" and \"will run out\". Condensed bold numerals carry dates and quantities; a plain humanist sans carries words. Structure comes from hairline rules, heavy 2px ink rules under section heads, the dotted perforation and the leaf stack, never from rounded cards.\n\nDensity is operational: supplier rows ranked by urgency in fixed columns, each with one download. Light and dark themes are complete twins; dark keeps the same ink-on-paper logic with lifted reds.",
    "keyCharacteristics": [
      "Paper leaves on a cool grey ground; square corners everywhere except 2px on controls.",
      "Red means \"today / runs out\". Nothing decorative is red.",
      "Numbers in condensed Oswald with tabular figures; words in Golos Text.",
      "Hairline and 2px ink rules instead of boxes.",
      "One soft leaf-lift shadow; no other depth."
    ],
    "rules": [
      {
        "name": "The Red Day Rule",
        "body": "Red marks only what is today or what will run out before arrival. If an element is red, the buyer must act on it.",
        "section": "colors"
      },
      {
        "name": "The Twin Theme Rule",
        "body": "Every token has a dark twin declared both under `prefers-color-scheme: dark` and `[data-theme=\"dark\"]`; never hardcode a light-only value.",
        "section": "colors"
      },
      {
        "name": "The Numerals Are Print Rule",
        "body": "A number the buyer reads as a quantity or date is set in Oswald; prose numbers stay in Golos.",
        "section": "typography"
      },
      {
        "name": "The Only Paper Lifts Rule",
        "body": "If it is not a calendar leaf, it does not cast a shadow. Month leaves rise 3px on hover; nothing else moves.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep red for today and for \"runs out before arrival\" only.",
      "Do set every quantity and date in Oswald with tabular figures.",
      "Do carry status as icon + label in a chip, never colour alone.",
      "Do separate with hairlines and 2px ink rules; keep surfaces square.",
      "Do keep body text at 15px or larger and define a dark twin for every new token."
    ],
    "donts": [
      "Don't build grey KPI-card grids or a sidebar; key numbers are inline margin notes.",
      "Don't round surfaces or add shadows to anything that is not a leaf.",
      "Don't add coloured side stripes to rows or multi-hue bars to month leaves.",
      "Don't use uppercase tracked labels as kickers above headings."
    ]
  }
