  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action, e.g. per-supplier Excel download.",
      "html": "<button class=\"ds-btn\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 4v11m0 0-4-4m4 4 4-4M5 20h14\"/></svg>Скачать заказ (Excel)</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--ink,#161716);background:var(--leaf,#fafaf8);color:var(--ink,#161716);padding:9px 14px;font:600 14px 'Golos Text',system-ui,sans-serif;border-radius:2px;cursor:pointer;transition:background .15s,color .15s}.ds-btn svg{width:16px;height:16px}.ds-btn:focus-visible{outline:2px solid var(--focus,#2a78d6);outline-offset:2px}.ds-btn:hover{background:var(--ink,#161716);color:var(--leaf,#fafaf8)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single red action per screen: download all orders.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 4v11m0 0-4-4m4 4 4-4M5 20h14\"/></svg>Скачать все заказы (Excel)</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--ink,#161716);background:var(--leaf,#fafaf8);color:var(--ink,#161716);padding:9px 14px;font:600 14px 'Golos Text',system-ui,sans-serif;border-radius:2px;cursor:pointer;transition:background .15s,color .15s}.ds-btn svg{width:16px;height:16px}.ds-btn:focus-visible{outline:2px solid var(--focus,#2a78d6);outline-offset:2px}.ds-btn-primary{background:var(--red,#c42a1f);border-color:var(--red,#c42a1f);color:#fff}.ds-btn-primary:hover{background:var(--red-ink,#a3221a);border-color:var(--red-ink,#a3221a)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions (CSV, show all, jump to calendar).",
      "html": "<button class=\"ds-btn ds-btn-ghost\">CSV</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--ink,#161716);background:var(--leaf,#fafaf8);color:var(--ink,#161716);padding:9px 14px;font:600 14px 'Golos Text',system-ui,sans-serif;border-radius:2px;cursor:pointer;transition:background .15s,color .15s}.ds-btn svg{width:16px;height:16px}.ds-btn:focus-visible{outline:2px solid var(--focus,#2a78d6);outline-offset:2px}.ds-btn-ghost{background:transparent;border-color:var(--rule-strong,#9aa09c);font-weight:500}.ds-btn-ghost:hover{background:var(--leaf,#fafaf8)}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip-critical",
      "description": "Status always as icon + label on a wash.",
      "html": "<span class=\"ds-st ds-crit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 4 2.8 19.5h18.4L12 4Z\"/><path d=\"M12 10v4.5M12 17v.2\"/></svg>Заказать сейчас</span> <span class=\"ds-st ds-good\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"m8 12.2 2.7 2.7L16.2 9.4\"/></svg>В порядке</span>",
      "css": ".ds-st{display:inline-flex;align-items:center;gap:5px;font:600 13px 'Golos Text',system-ui,sans-serif;padding:1px 7px 1px 5px;border-radius:2px}.ds-st svg{width:14px;height:14px}.ds-crit{color:var(--red-ink,#a3221a);background:var(--red-wash,#f8e3e0)}.ds-good{color:var(--green,#1d7a35);background:var(--green-wash,#e2f1e5)}"
    },
    {
      "name": "Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Sticky section tabs; active tab has a 3px red underline.",
      "html": "<div class=\"ds-tabs\"><button aria-selected=\"true\">Календарь <span>12</span></button><button>Риски <span>165</span></button><button>Все товары <span>791</span></button></div>",
      "css": ".ds-tabs{display:flex;border-bottom:1px solid var(--rule-strong,#9aa09c);background:var(--ground,#eceeec)}.ds-tabs button{all:unset;cursor:pointer;padding:14px 16px 12px;font:600 14px 'Golos Text',system-ui,sans-serif;color:var(--ink-2,#4f5351);border-bottom:3px solid transparent;display:flex;gap:6px}.ds-tabs button span{font:500 13px Oswald,'Arial Narrow',system-ui,sans-serif;color:var(--ink-3,#727775)}.ds-tabs button:hover{color:var(--ink,#161716)}.ds-tabs button[aria-selected=true]{color:var(--ink,#161716);border-bottom-color:var(--red,#c42a1f)}.ds-tabs button:focus-visible{outline:2px solid var(--focus,#2a78d6);outline-offset:-2px}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Filter field over the item table.",
      "html": "<input class=\"ds-input\" placeholder=\"Поиск по артикулу\">",
      "css": ".ds-input{border:1px solid var(--rule-strong,#9aa09c);background:var(--leaf,#fafaf8);color:var(--ink,#161716);padding:8px 10px;min-height:38px;border-radius:2px;font:400 15px 'Golos Text',system-ui,sans-serif}.ds-input:focus-visible{outline:2px solid var(--focus,#2a78d6);outline-offset:2px}"
    },
    {
      "name": "Day Leaf",
      "kind": "custom",
      "refersTo": "day-leaf",
      "description": "Signature: today's tear-off leaf on a two-sheet stack.",
      "html": "<div class=\"ds-stack\"><div class=\"ds-leaf\"><div class=\"ds-wk\">четверг</div><div class=\"ds-day\">13</div><div class=\"ds-mon\">августа 2026</div></div></div>",
      "css": ".ds-stack{position:relative;width:240px;margin-bottom:12px}.ds-stack::before{content:'';position:absolute;left:6px;right:6px;bottom:-5px;height:8px;background:var(--leaf-2,#f3f4f2);box-shadow:var(--shadow,0 1px 0 rgba(22,23,22,.06),0 6px 18px -10px rgba(22,23,22,.22))}.ds-leaf{position:relative;z-index:1;background:var(--leaf,#fafaf8);box-shadow:var(--shadow,0 1px 0 rgba(22,23,22,.06),0 6px 18px -10px rgba(22,23,22,.22));padding:26px 22px 22px;text-align:center;color:var(--ink,#161716)}.ds-leaf::before{content:'';position:absolute;left:0;right:0;top:0;height:10px;background:var(--red,#c42a1f)}.ds-leaf::after{content:'';position:absolute;left:10px;right:10px;top:16px;border-top:2px dotted var(--rule-strong,#9aa09c)}.ds-wk{margin-top:12px;text-transform:uppercase;letter-spacing:.12em;font:600 12px 'Golos Text',system-ui,sans-serif;color:var(--ink-2,#4f5351)}.ds-day{font:600 132px/.95 Oswald,'Arial Narrow',system-ui,sans-serif;letter-spacing:-.02em;color:var(--red,#c42a1f)}.ds-mon{font:500 24px Oswald,'Arial Narrow',system-ui,sans-serif;text-transform:uppercase;letter-spacing:.04em}"
    },
    {
      "name": "Month Leaf",
      "kind": "custom",
      "refersTo": "month-leaf",
      "description": "Signature: one order month in the calendar; red band when current.",
      "html": "<button class=\"ds-ml ds-now\"><span class=\"ds-mm\">август</span><span class=\"ds-mq\">182</span><span class=\"ds-ms\">22 поставщика</span></button><button class=\"ds-ml\"><span class=\"ds-mm\">сентябрь</span><span class=\"ds-mq\">47</span><span class=\"ds-ms\">9 поставщиков</span></button>",
      "css": ".ds-ml{all:unset;cursor:pointer;box-sizing:border-box;width:150px;min-height:132px;margin-right:8px;vertical-align:top;background:var(--leaf,#fafaf8);box-shadow:var(--shadow,0 1px 0 rgba(22,23,22,.06),0 6px 18px -10px rgba(22,23,22,.22));position:relative;padding:24px 12px 12px;display:inline-flex;flex-direction:column;color:var(--ink,#161716);transition:transform .18s cubic-bezier(.2,.8,.2,1)}.ds-ml::before{content:'';position:absolute;left:0;right:0;top:0;height:6px;background:var(--ink,#161716)}.ds-ml.ds-now::before{background:var(--red,#c42a1f)}.ds-ml::after{content:'';position:absolute;left:8px;right:8px;top:12px;border-top:2px dotted var(--rule-strong,#9aa09c)}.ds-ml:hover{transform:translateY(-3px)}.ds-ml:focus-visible{outline:2px solid var(--focus,#2a78d6);outline-offset:2px}.ds-mm{font:600 12px 'Golos Text',system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2,#4f5351)}.ds-mq{font:600 34px/1.05 Oswald,'Arial Narrow',system-ui,sans-serif;margin-top:6px}.ds-now .ds-mq{color:var(--red,#c42a1f)}.ds-ms{font:12px 'Golos Text',system-ui,sans-serif;color:var(--ink-2,#4f5351);margin-top:auto}"
    },
