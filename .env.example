# Необязательно. Ключи заполняются сами, когда сервис выбран в дашборде:
# «Управление» → «Комментарий аналитика» (или при первом запуске). Этот файл — для ручной настройки.
# Скопируйте его в .env и вставьте ключ нужного сервиса. Сервис выбирается в config.toml, раздел «комментарий».
ANTHROPIC_API_KEY=
# ChatGPT, DeepSeek, YandexGPT, OpenRouter и другие OpenAI-совместимые:
OPENAI_API_KEY=
# GigaChat: «Authorization key» из личного кабинета developers.sber.ru
GIGACHAT_AUTH_KEY=
# МойСклад: «Настройки» → «Токены» (нужен, если включена загрузка из МойСклад)
MOYSKLAD_TOKEN=
# Ollama / LM Studio обычно без ключа
LOCAL_API_KEY=
