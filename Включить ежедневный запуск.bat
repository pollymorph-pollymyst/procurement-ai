@echo off
chcp 65001 >nul
rem Двойной щелчок: включить автопересчёт по расписанию из config.toml (по умолчанию каждый день в 07:00).
rem Время и дни удобнее менять в дашборде: «Открыть закупки.bat» → «Управление» → «Расписание».
rem Выключить: запустить с параметром off — «Включить ежедневный запуск.bat» off
setlocal
set "MODE=on"
if /i "%~1"=="off" set "MODE=off"
call "%~dp0scripts\run.bat" schedule %MODE% --no-open
if errorlevel 1 (
  echo Не получилось настроить расписание. Попробуйте запустить этот файл от имени администратора.
)
pause
